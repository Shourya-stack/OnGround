# =============================================================================
# OnGround Backend — Environment Variables Template
# =============================================================================

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
# IMPORTANT: Service role key bypasses RLS and must NEVER be exposed in frontend bundle
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# LLM Provider Configuration
LLM_PROVIDER=openrouter
LLM_MODEL=liquid/lfm-2.5-2.6b:free
OPENROUTER_API_KEY=your-openrouter-api-key

# Rate Limiting (Format: <count>/<second|minute|hour>)
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_EXTRACTION=10/minute
RATE_LIMIT_MATCH=30/minute

# Server & Environment Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# CORS Configuration (Production origins comma-separated)
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
