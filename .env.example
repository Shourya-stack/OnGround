# ==========================================
# TrueLine — Environment Variables Template
# ==========================================
# This is a reference file. Do not put real secrets here.
# Copy backend/.env.example to backend/.env for backend configuration.
# Copy frontend/.env.example to frontend/.env for frontend configuration.

# --- Backend Configuration (backend/.env) ---
# SUPABASE_URL=https://[project-id].supabase.co
# SUPABASE_SERVICE_KEY=[your-supabase-service-role-key]
# LLM_PROVIDER=openrouter
# LLM_MODEL=[openrouter-model-string]
# OPENROUTER_API_KEY=[your-openrouter-api-key]

# --- Frontend Configuration (frontend/.env) ---
# VITE_SUPABASE_URL=https://[project-id].supabase.co
# VITE_SUPABASE_ANON_KEY=[your-supabase-anon-key]
# VITE_API_BASE_URL=http://localhost:8000
